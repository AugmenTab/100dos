<section
  class="tab{{#if tabs.primary.skills.active}} active{{/if}}"
  data-group="primary"
  data-tab="skills"
  role="tabpanel"
  id="{{sheetId}}-primary-panel-skills"
  aria-labelledby="{{sheetId}}-primary-tab-skills"
>
  <div class="ledger-table-wrap">
    <table class="ledger-table dense-table">
      <thead>
        <tr>
          <th scope="col" colspan="2" class="dense-table-name-header">{{localize "DOS100.skills.table.name"}}</th>
          <th scope="col">{{localize "DOS100.skills.table.difficulty"}}</th>
          <th scope="col">{{localize "DOS100.skills.table.type"}}</th>
          <th scope="col">{{localize "DOS100.skills.table.training"}}</th>
          <th scope="col">{{localize "DOS100.skills.table.characteristic"}}</th>
          <th scope="col">
            {{!-- TODO: not wired up yet — no Add-Skill modal exists. --}}
            <a
              role="button"
              tabindex="0"
              class="icon-button"
              aria-label="{{localize "DOS100.skills.table.add"}}"
            ><i class="fa-solid fa-plus" inert></i></a>
          </th>
        </tr>
      </thead>
      <tbody>
        {{#if skillRows.length}}
          {{#each skillRows}}
            <tr>
              <td>
                <a
                  role="button"
                  tabindex="0"
                  class="icon-button dense-table-pin"
                  data-action="togglePinnedSkill"
                  data-tag="{{this.tag}}"
                  aria-pressed="{{this.pinned}}"
                  aria-label="{{#if this.pinned}}{{localize "DOS100.skills.table.unpin" name=this.name}}{{else}}{{localize "DOS100.skills.table.pin" name=this.name}}{{/if}}"
                >
                  {{#if this.pinned}}
                    <i class="fa-solid fa-thumbtack" inert></i>
                  {{else}}
                    <i class="fa-solid fa-thumbtack-slash" inert></i>
                  {{/if}}
                </a>
              </td>
              <td class="dense-table-name">
                <div class="dense-table-name-inner">
                  <span>{{this.name}}</span>
                  {{!-- TODO: not wired up yet — no Skill edit modal exists. --}}
                  <a
                    role="button"
                    tabindex="0"
                    class="icon-button"
                    data-tag="{{this.tag}}"
                    aria-label="{{localize "DOS100.skills.table.edit" name=this.name}}"
                  ><i class="fa-solid fa-pen-to-square" inert></i></a>
                  {{!-- TODO: not wired up yet — no description popup exists. --}}
                  <a
                    role="button"
                    tabindex="0"
                    class="icon-button"
                    data-tag="{{this.tag}}"
                    aria-label="{{localize "DOS100.skills.table.viewDescription" name=this.name}}"
                  ><i class="fa-solid fa-book-open" inert></i></a>
                </div>
              </td>
              <td>{{localize (concat "DOS100.skills.difficulty." this.difficulty)}}</td>
              <td>{{#each this.type}}{{#unless @first}}, {{/unless}}{{localize (concat "DOS100.skills.type." this)}}{{/each}}</td>
              <td>
                <select
                  class="eyebrow-label"
                  name="system.skills.{{this.tag}}.training"
                  aria-label="{{localize "DOS100.skills.table.training"}} — {{this.name}}"
                >
                  {{selectOptions ../skillTrainingOptions selected=this.training}}
                </select>
              </td>
              <td>
                <select
                  class="eyebrow-label"
                  name="system.skills.{{this.tag}}.characteristic"
                  aria-label="{{localize "DOS100.skills.table.characteristic"}} — {{this.name}}"
                >
                  {{selectOptions this.characteristicOptions selected=this.characteristic}}
                </select>
              </td>
              <td>
                {{!-- TODO: not wired up yet — no Skill roll/use behavior exists. --}}
                <button
                  type="button"
                  class="simple-button"
                  data-tooltip-html="{{contributionTooltipHtml this.name this.value this.contributions}}"
                  aria-label="{{localize "DOS100.skills.table.roll" name=this.name}}"
                >{{localizeNumber this.value}}</button>
              </td>
            </tr>
          {{/each}}
        {{else}}
          <tr>
            <td colspan="7" class="ledger-table-empty-state">{{localize "DOS100.skills.table.empty"}}</td>
          </tr>
        {{/if}}
      </tbody>
    </table>
  </div>

  <section aria-label="{{localize "DOS100.educations.label"}}">
    <h3 class="pc-section-heading pc-section-heading-value">
      <span aria-hidden="true">{{localize "DOS100.educations.label"}}</span>
      <span>
        <span aria-label="{{localize "DOS100.educations.value"}}">{{localizeNumber actor.system.education.value}}</span>
        <span aria-hidden="true"> / </span>
        <span
          aria-label="{{localize "DOS100.educations.max"}}"
          data-tooltip-html="{{contributionTooltipHtml (localize "DOS100.educations.max") (localizeNumber actor.system.education.max) actor.system.education.contributions}}"
        >{{localizeNumber actor.system.education.max}}</span>
      </span>
    </h3>

    <div class="ledger-table-wrap">
      <table class="ledger-table dense-table">
        <thead>
          <tr>
            <th scope="col" colspan="2" class="dense-table-name-header">{{localize "DOS100.educations.table.name"}}</th>
            <th scope="col">{{localize "DOS100.educations.table.difficulty"}}</th>
            <th scope="col">{{localize "DOS100.educations.table.training"}}</th>
            <th scope="col">{{localize "DOS100.educations.table.target"}}</th>
            <th scope="col">
              {{!-- TODO: not wired up yet — no Education creation/purchase flow exists. --}}
              <a
                role="button"
                tabindex="0"
                class="icon-button"
                aria-label="{{localize "DOS100.educations.table.add"}}"
              ><i class="fa-solid fa-plus" inert></i></a>
            </th>
          </tr>
        </thead>
        <tbody>
          {{#if educationRows.length}}
            {{#each educationRows}}
              <tr>
                <td>
                  <a
                    role="button"
                    tabindex="0"
                    class="icon-button dense-table-pin"
                    data-tag="{{this.tag}}"
                    aria-pressed="{{this.pinned}}"
                    aria-label="{{#if this.pinned}}{{localize "DOS100.educations.table.unpin" name=this.name}}{{else}}{{localize "DOS100.educations.table.pin" name=this.name}}{{/if}}"
                  >
                    {{#if this.pinned}}
                      <i class="fa-solid fa-thumbtack" inert></i>
                    {{else}}
                      <i class="fa-solid fa-thumbtack-slash" inert></i>
                    {{/if}}
                  </a>
                </td>
                <td class="dense-table-name">
                  <div class="dense-table-name-inner">
                    <span>{{this.name}}</span>
                    {{!-- TODO: not wired up yet — no Education edit modal exists. --}}
                    <a
                      role="button"
                      tabindex="0"
                      class="icon-button"
                      data-tag="{{this.tag}}"
                      aria-label="{{localize "DOS100.educations.table.edit" name=this.name}}"
                    ><i class="fa-solid fa-pen-to-square" inert></i></a>
                    {{!-- TODO: not wired up yet — no description popup exists. --}}
                    <a
                      role="button"
                      tabindex="0"
                      class="icon-button"
                      data-tag="{{this.tag}}"
                      aria-label="{{localize "DOS100.educations.table.viewDescription" name=this.name}}"
                    ><i class="fa-solid fa-book-open" inert></i></a>
                    {{!-- TODO: not wired up yet — no Education deletion exists. --}}
                    <a
                      role="button"
                      tabindex="0"
                      class="icon-button dense-table-delete"
                      data-tag="{{this.tag}}"
                      aria-label="{{localize "DOS100.educations.table.delete" name=this.name}}"
                    ><i class="fa-solid fa-trash" inert></i></a>
                  </div>
                </td>
                <td>{{localize (concat "DOS100.skills.difficulty." this.difficulty)}}</td>
                <td>{{localize (concat "DOS100.educations.training." this.training)}}</td>
                <td>
                  <select
                    class="eyebrow-label"
                    name="system.educations.{{this.tag}}.selected"
                    aria-label="{{localize "DOS100.educations.table.target"}} — {{this.name}}"
                  >
                    {{selectOptions this.targetOptions selected=this.selected}}
                  </select>
                </td>
                <td>
                  {{!-- TODO: not wired up yet — no Education roll/use behavior exists. --}}
                  <button
                    type="button"
                    class="simple-button"
                    data-tooltip-html="{{contributionTooltipHtml this.name this.value this.contributions}}"
                    aria-label="{{localize "DOS100.educations.table.roll" name=this.name}}"
                  >{{localizeNumber this.value}}</button>
                </td>
              </tr>
            {{/each}}
          {{else}}
            <tr>
              <td colspan="6" class="ledger-table-empty-state">{{localize "DOS100.educations.table.empty"}}</td>
            </tr>
          {{/if}}
        </tbody>
      </table>
    </div>
  </section>
</section>
