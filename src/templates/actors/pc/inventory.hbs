<section
  class="tab{{#if tabs.primary.inventory.active}} active{{/if}}"
  data-group="primary"
  data-tab="inventory"
  role="tabpanel"
  id="{{sheetId}}-primary-panel-inventory"
  aria-labelledby="{{sheetId}}-primary-tab-inventory"
>
  <section class="pc-inventory-encumbrance" aria-label="{{localize "DOS100.encumbrance.label"}}">
    <div class="simple-stat-table">
      <div>
        <div>
          <span class="eyebrow-label">{{localize "DOS100.encumbrance.carried"}}</span>
          <span>{{localizeNumber actor.system.encumbrance.carried}} {{localize "DOS100.inventory.table.weightUnit"}}</span>
        </div>
        <div>
          <span class="eyebrow-label">{{localize "DOS100.encumbrance.felt"}}</span>
          <span>{{localizeNumber actor.system.encumbrance.felt}} {{localize "DOS100.inventory.table.weightUnit"}}</span>
        </div>
        <div>
          <span class="eyebrow-label">{{localize "DOS100.encumbrance.total"}}</span>
          <span>{{localizeNumber actor.system.encumbrance.total}} {{localize "DOS100.inventory.table.weightUnit"}}</span>
        </div>
        <div>
          <span class="eyebrow-label">{{localize "DOS100.encumbrance.carriedValue"}}</span>
          <span>{{localizeNumber actor.system.finances.carried}}</span>
        </div>
      </div>
    </div>

    <div class="pc-encumbrance-bars" role="group" aria-label="{{localize "DOS100.encumbrance.bars"}}">
      {{#each encumbranceBands}}
        <div class="pc-encumbrance-bar">
          <div class="pc-encumbrance-bar-fill" style="width: {{this.fillPercent}}%"></div>
          <span class="pc-encumbrance-bar-label">{{localize (concat "DOS100.encumbrance.bands." this.labelKey)}} ({{localizeNumber this.thresholdValue}} {{localize "DOS100.inventory.table.weightUnit"}})</span>
        </div>
      {{/each}}
    </div>

    <div class="simple-stat-table">
      <div>
        <div>
          <span class="eyebrow-label">{{localize "DOS100.encumbrance.thresholds.carry"}}</span>
          <span data-tooltip-html="{{contributionTooltipHtml (localize "DOS100.encumbrance.thresholds.carry") (localizeNumber actor.system.encumbrance.thresholds.base.carry.value) actor.system.encumbrance.thresholds.base.carry.contributions}}">{{localizeNumber actor.system.encumbrance.thresholds.base.carry.value}} {{localize "DOS100.inventory.table.weightUnit"}}</span>
        </div>
        <div>
          <span class="eyebrow-label">{{localize "DOS100.encumbrance.thresholds.lift"}}</span>
          <span data-tooltip-html="{{contributionTooltipHtml (localize "DOS100.encumbrance.thresholds.lift") (localizeNumber actor.system.encumbrance.thresholds.base.lift.value) actor.system.encumbrance.thresholds.base.lift.contributions}}">{{localizeNumber actor.system.encumbrance.thresholds.base.lift.value}} {{localize "DOS100.inventory.table.weightUnit"}}</span>
        </div>
        <div>
          <span class="eyebrow-label">{{localize "DOS100.encumbrance.thresholds.push"}}</span>
          <span data-tooltip-html="{{contributionTooltipHtml (localize "DOS100.encumbrance.thresholds.push") (localizeNumber actor.system.encumbrance.thresholds.base.push.value) actor.system.encumbrance.thresholds.base.push.contributions}}">{{localizeNumber actor.system.encumbrance.thresholds.base.push.value}} {{localize "DOS100.inventory.table.weightUnit"}}</span>
        </div>
      </div>
    </div>
  </section>

  <hr />

  {{!-- TODO: no Weapons Item type exists yet — stays a full empty
       wireframe (header/columns/Add/empty-state only). --}}
  {{> "systems/100dos/templates/actors/pc/inventory/table-with-actions.hbs"
    label=(localize "DOS100.inventory.weapons.label")
    empty=(localize "DOS100.inventory.weapons.empty")
    add=(localize "DOS100.inventory.weapons.add")
  }}

  {{> "systems/100dos/templates/actors/pc/inventory/table-with-slot.hbs"
    label=(localize "DOS100.inventory.armorShields.label")
    empty=(localize "DOS100.inventory.armorShields.empty")
    add=(localize "DOS100.inventory.armorShields.add")
    rows=armorItems
  }}

  {{!-- TODO: no Equipment Item type exists yet — stays a full empty
       wireframe. --}}
  {{> "systems/100dos/templates/actors/pc/inventory/table-with-slot.hbs"
    label=(localize "DOS100.inventory.equipment.label")
    empty=(localize "DOS100.inventory.equipment.empty")
    add=(localize "DOS100.inventory.equipment.add")
  }}

  {{!-- TODO: no Consumables Item type exists yet — stays a full empty
       wireframe. --}}
  {{> "systems/100dos/templates/actors/pc/inventory/table-with-actions.hbs"
    label=(localize "DOS100.inventory.consumables.label")
    empty=(localize "DOS100.inventory.consumables.empty")
    add=(localize "DOS100.inventory.consumables.add")
  }}

  {{> "systems/100dos/templates/actors/pc/inventory/table-with-actions.hbs"
    label=(localize "DOS100.inventory.gear.label")
    empty=(localize "DOS100.inventory.gear.empty")
    add=(localize "DOS100.inventory.gear.add")
    rows=gearItems
  }}

  {{> "systems/100dos/templates/actors/pc/inventory/table-simple.hbs"
    label=(localize "DOS100.inventory.ammunition.label")
    empty=(localize "DOS100.inventory.ammunition.empty")
    add=(localize "DOS100.inventory.ammunition.add")
    rows=ammunitionItems
  }}

  {{!-- TODO: no Miscellaneous Item type exists yet — stays a full empty
       wireframe. --}}
  {{> "systems/100dos/templates/actors/pc/inventory/table-simple.hbs"
    label=(localize "DOS100.inventory.miscellaneous.label")
    empty=(localize "DOS100.inventory.miscellaneous.empty")
    add=(localize "DOS100.inventory.miscellaneous.add")
  }}

  {{!-- TODO: no Containers Item type exists yet — stays a full empty
       wireframe. --}}
  {{> "systems/100dos/templates/actors/pc/inventory/table-simple.hbs"
    label=(localize "DOS100.inventory.containers.label")
    empty=(localize "DOS100.inventory.containers.empty")
    add=(localize "DOS100.inventory.containers.add")
  }}
</section>
