<tr>
  <td class="dense-table-name">
    <div class="dense-table-name-inner">
      <img class="dense-table-item-img" src="{{this.item.img}}" alt="" />
      <span{{#if (eq this.item.system.quantity 0)}} class="depleted"{{/if}}>
        {{this.item.name}}{{#if (gt this.item.system.quantity 1)}} (&times;{{localizeNumber this.item.system.quantity}}){{/if}}
      </span>
    </div>
  </td>
  <td>
    {{#if this.item.system.slot}}
      {{localize (concat "DOS100.inventory.bodySlot." this.item.system.slot)}}
    {{/if}}
  </td>
  <td>
    {{#if this.hasActions}}
      {{!-- TODO: not wired up yet — no roll resolution exists. --}}
      <a
        role="button"
        tabindex="0"
        class="icon-button"
        aria-label="{{localize "DOS100.item.table.useActions" name=this.item.name}}"
      ><i class="fa-solid fa-dice-d10" inert></i></a>
    {{/if}}
  </td>
  <td>
    {{#if this.uses}}
      {{localizeNumber this.uses.value}} / {{localizeNumber this.uses.max}}
    {{/if}}
  </td>
  <td>
    <a
      role="button"
      tabindex="0"
      class="icon-button"
      data-action="toggleItemCarried"
      data-item-id="{{this.item.id}}"
      aria-pressed="{{this.item.system.carried}}"
      aria-label="{{localize "DOS100.inventory.table.toggleCarried" name=this.item.name}}"
    >
      {{#if this.item.system.carried}}
        <i class="fa-solid fa-check" inert></i>
      {{else}}
        <i class="fa-solid fa-times" inert></i>
      {{/if}}
    </a>
  </td>
  <td>
    <a
      role="button"
      tabindex="0"
      class="icon-button"
      data-action="toggleItemEquipped"
      data-item-id="{{this.item.id}}"
      aria-pressed="{{this.item.system.equipped}}"
      aria-label="{{localize "DOS100.inventory.table.toggleEquipped" name=this.item.name}}"
    >
      {{#if this.item.system.equipped}}
        <i class="fa-solid fa-check" inert></i>
      {{else}}
        <i class="fa-solid fa-times" inert></i>
      {{/if}}
    </a>
  </td>
  <td class="ledger-table-value">{{localizeNumber this.item.system.weight.actual.total}} {{localize "DOS100.inventory.table.weightUnit"}}</td>
  <td class="ledger-table-value">{{localizeNumber this.item.system.weight.felt.total}} {{localize "DOS100.inventory.table.weightUnit"}}</td>
  <td>
    {{!-- TODO: not wired up yet — no quantity update flow exists. --}}
    <a
      role="button"
      tabindex="0"
      class="icon-button"
      aria-label="{{localize "DOS100.inventory.table.increaseQuantity" name=this.item.name}}"
    ><i class="fa-solid fa-plus" inert></i></a>
    <a
      role="button"
      tabindex="0"
      class="icon-button"
      aria-label="{{localize "DOS100.inventory.table.decreaseQuantity" name=this.item.name}}"
    ><i class="fa-solid fa-minus" inert></i></a>
    <a
      role="button"
      tabindex="0"
      class="icon-button"
      data-action="editItem"
      data-item-id="{{this.item.id}}"
      aria-label="{{localize "DOS100.item.table.edit" name=this.item.name}}"
    ><i class="fa-solid fa-pen-to-square" inert></i></a>
    <a
      role="button"
      tabindex="0"
      class="icon-button"
      data-action="duplicateItem"
      data-item-id="{{this.item.id}}"
      aria-label="{{localize "DOS100.item.table.duplicate" name=this.item.name}}"
    ><i class="fa-solid fa-copy" inert></i></a>
    {{!-- TODO: not wired up yet — no gift/transfer flow exists. --}}
    <a
      role="button"
      tabindex="0"
      class="icon-button"
      aria-label="{{localize "DOS100.inventory.table.gift" name=this.item.name}}"
    ><i class="fa-solid fa-gift" inert></i></a>
    <a
      role="button"
      tabindex="0"
      class="icon-button"
      data-action="deleteItem"
      data-item-id="{{this.item.id}}"
      aria-label="{{localize "DOS100.item.table.delete" name=this.item.name}}"
    ><i class="fa-solid fa-trash" inert></i></a>
  </td>
</tr>
