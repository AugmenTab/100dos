<section aria-label="{{label}}">
  <div class="ledger-table-wrap">
    <table class="ledger-table dense-table">
      <thead>
        <tr>
          <th scope="col" class="dense-table-name-header">{{label}}</th>
          <th scope="col">{{localize "DOS100.inventory.table.slot"}}</th>
          <th scope="col">{{localize "DOS100.item.table.actions"}}</th>
          <th scope="col">{{localize "DOS100.item.table.uses"}}</th>
          <th scope="col">{{localize "DOS100.inventory.table.carried"}}</th>
          <th scope="col">{{localize "DOS100.inventory.table.equipped"}}</th>
          <th scope="col">{{localize "DOS100.inventory.table.weight"}}</th>
          <th scope="col">{{localize "DOS100.inventory.table.feltWeight"}}</th>
          <th scope="col">
            <a
              role="button"
              tabindex="0"
              class="icon-button"
              aria-label="{{add}}"
            ><i class="fa-solid fa-plus" inert></i></a>
          </th>
        </tr>
      </thead>
      <tbody>
        {{#if rows.length}}
          {{#each rows}}
            {{> "systems/100dos/templates/actors/pc/inventory/row-with-slot.hbs"}}
          {{/each}}
        {{else}}
          <tr>
            <td colspan="9" class="ledger-table-empty-state">{{empty}}</td>
          </tr>
        {{/if}}
      </tbody>
    </table>
  </div>
</section>
