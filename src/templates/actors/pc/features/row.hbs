<tr>
  <td class="dense-table-name">
    <div class="dense-table-name-inner">
      <img class="dense-table-item-img" src="{{this.item.img}}" alt="" />
      <span>{{this.item.name}}</span>
    </div>
  </td>
  <td>
    {{#if this.hasActions}}
      {{!-- TODO: not wired up yet — no roll resolution exists. --}}
      <a
        role="button"
        tabindex="0"
        class="icon-button"
        aria-label="{{localize "DOS100.item.table.useActions" name=this.item.name}}"
      ><i class="fa-solid fa-dice-d10" inert></i></a>
    {{/if}}
  </td>
  <td>
    {{#if this.uses}}
      {{localizeNumber this.uses.value}} / {{localizeNumber this.uses.max}}
    {{/if}}
  </td>
  <td>
    <a
      role="button"
      tabindex="0"
      class="icon-button"
      data-action="editItem"
      data-item-id="{{this.item.id}}"
      aria-label="{{localize "DOS100.item.table.edit" name=this.item.name}}"
    ><i class="fa-solid fa-pen-to-square" inert></i></a>
    <a
      role="button"
      tabindex="0"
      class="icon-button"
      data-action="duplicateItem"
      data-item-id="{{this.item.id}}"
      aria-label="{{localize "DOS100.item.table.duplicate" name=this.item.name}}"
    ><i class="fa-solid fa-copy" inert></i></a>
    <a
      role="button"
      tabindex="0"
      class="icon-button"
      data-action="deleteItem"
      data-item-id="{{this.item.id}}"
      aria-label="{{localize "DOS100.item.table.delete" name=this.item.name}}"
    ><i class="fa-solid fa-trash" inert></i></a>
  </td>
</tr>
