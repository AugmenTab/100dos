<tr>
  <td class="dense-table-flexible">
    <div class="dense-table-name-inner">
      <img class="dense-table-item-img" src="{{this.item.img}}" alt="" />
      <span{{#if (eq this.item.system.active false)}} class="depleted"{{/if}}>{{this.item.name}}</span>
    </div>
  </td>
  <td>
    {{#if this.hasActions}}
      {{!-- TODO: not wired up yet — no roll resolution exists. --}}
      <button
        type="button"
        class="icon-button"
        aria-label="{{localize "DOS100.item.table.useActions" name=this.item.name}}"
      ><i class="fa-solid fa-dice-d10" inert></i></button>
    {{/if}}
  </td>
  <td>
    {{#if this.uses}}
      {{localizeNumber this.uses.value}} / {{localizeNumber this.uses.max}}
    {{/if}}
  </td>
  <td>
    {{#if showActiveToggle}}
      <input
        type="checkbox"
        data-action="toggleItemActive"
        data-item-id="{{this.item.id}}"
        {{#if this.item.system.active}}checked{{/if}}
        aria-label="{{localize "DOS100.item.table.toggleActive" name=this.item.name}}"
      />
    {{/if}}
    <button
      type="button"
      class="icon-button"
      data-action="editItem"
      data-item-id="{{this.item.id}}"
      aria-label="{{localize "DOS100.item.table.edit" name=this.item.name}}"
    ><i class="fa-solid fa-pen-to-square" inert></i></button>
    <button
      type="button"
      class="icon-button"
      data-action="duplicateItem"
      data-item-id="{{this.item.id}}"
      aria-label="{{localize "DOS100.item.table.duplicate" name=this.item.name}}"
    ><i class="fa-solid fa-copy" inert></i></button>
    <button
      type="button"
      class="icon-button"
      data-action="deleteItem"
      data-item-id="{{this.item.id}}"
      aria-label="{{localize "DOS100.item.table.delete" name=this.item.name}}"
    ><i class="fa-solid fa-trash" inert></i></button>
  </td>
</tr>
