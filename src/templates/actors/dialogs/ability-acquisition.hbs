<div class="ability-acquisition">
  <p>{{question}}</p>
  <div class="dos100-form-group">
    <label for="ability-xp-cost">{{localize "DOS100.abilityAcquisition.xpCost"}}</label>
    <input
      type="number"
      id="ability-xp-cost"
      name="xpCost"
      value="{{xpCost}}"
      min="0"
      step="1"
    />
  </div>
  <div class="ability-acquisition-buttons">
    <button type="button" data-action="create">{{localize "DOS100.abilityAcquisition.create"}}</button>
    <button type="button" data-action="skip">{{localize "DOS100.abilityAcquisition.skip"}}</button>
    <button type="button" data-action="cancelDialog">{{localize "DOS100.abilityAcquisition.cancel"}}</button>
  </div>
</div>
