<section
  class="tab{{#if tabs.primary.changes.active}} active{{/if}}"
  data-group="primary"
  data-tab="changes"
  role="tabpanel"
  id="{{sheetId}}-primary-panel-changes"
  aria-labelledby="{{sheetId}}-primary-tab-changes"
>
  <div class="dense-table-wrap">
    <table class="dense-table">
      <thead>
        <tr>
          <th scope="col" colspan="3" class="dense-table-flexible">{{localize "DOS100.item.changes.label"}}</th>
          <th scope="col">
            <a
              role="button"
              tabindex="0"
              class="icon-button"
              data-action="addChange"
              aria-label="{{localize "DOS100.item.changes.add"}}"
            ><i class="fa-solid fa-plus" inert></i></a>
          </th>
        </tr>
      </thead>
      <tbody>
        {{#if resolvedChanges.length}}
          {{#each resolvedChanges}}
            <tr>
              <td>
                <span aria-label="{{#if (eq this.mode "add")}}{{localize "DOS100.item.changes.mode.add"}}{{else}}{{localize "DOS100.item.changes.mode.set"}}{{/if}}">
                  {{#if (eq this.mode "add")}}+{{else}}={{/if}}
                </span>
              </td>
              <td class="dense-table-flexible">
                <input
                  type="text"
                  value="{{this.formula}}"
                  disabled
                  aria-label="{{localize "DOS100.item.changes.formula"}}"
                />
              </td>
              <td><code>{{this.targetLabel}}</code></td>
              <td>
                <a
                  role="button"
                  tabindex="0"
                  class="icon-button"
                  data-action="editChange"
                  data-identifier="{{this.id}}"
                  aria-label="{{localize "DOS100.item.changes.edit"}}"
                ><i class="fa-solid fa-pen-to-square" inert></i></a>
                <a
                  role="button"
                  tabindex="0"
                  class="icon-button"
                  data-action="duplicateChange"
                  data-identifier="{{this.id}}"
                  aria-label="{{localize "DOS100.item.changes.duplicate"}}"
                ><i class="fa-solid fa-copy" inert></i></a>
                <a
                  role="button"
                  tabindex="0"
                  class="icon-button"
                  data-action="deleteChange"
                  data-identifier="{{this.id}}"
                  aria-label="{{localize "DOS100.item.changes.delete"}}"
                ><i class="fa-solid fa-trash" inert></i></a>
              </td>
            </tr>
          {{/each}}
        {{else}}
          <tr>
            <td colspan="4" class="dense-table-empty-state">{{localize "DOS100.item.changes.empty"}}</td>
          </tr>
        {{/if}}
      </tbody>
    </table>
  </div>

  <div class="dense-table-wrap">
    <table class="dense-table">
      <thead>
        <tr>
          <th scope="col" colspan="2" class="dense-table-flexible">{{localize "DOS100.item.conditionals.label"}}</th>
          <th scope="col">
            <a
              role="button"
              tabindex="0"
              class="icon-button"
              data-action="addConditional"
              aria-label="{{localize "DOS100.item.conditionals.add"}}"
            ><i class="fa-solid fa-plus" inert></i></a>
          </th>
        </tr>
      </thead>
      <tbody>
        {{#if resolvedConditionals.length}}
          {{#each resolvedConditionals}}
            <tr>
              <td class="dense-table-flexible">
                <textarea
                  disabled
                  rows="2"
                  aria-label="{{localize "DOS100.item.conditionals.notes"}}"
                >{{this.value}}</textarea>
              </td>
              <td><code>{{this.targetLabel}}</code></td>
              <td>
                <a
                  role="button"
                  tabindex="0"
                  class="icon-button"
                  data-action="editConditional"
                  data-identifier="{{this.id}}"
                  aria-label="{{localize "DOS100.item.conditionals.edit"}}"
                ><i class="fa-solid fa-pen-to-square" inert></i></a>
                <a
                  role="button"
                  tabindex="0"
                  class="icon-button"
                  data-action="duplicateConditional"
                  data-identifier="{{this.id}}"
                  aria-label="{{localize "DOS100.item.conditionals.duplicate"}}"
                ><i class="fa-solid fa-copy" inert></i></a>
                <a
                  role="button"
                  tabindex="0"
                  class="icon-button"
                  data-action="deleteConditional"
                  data-identifier="{{this.id}}"
                  aria-label="{{localize "DOS100.item.conditionals.delete"}}"
                ><i class="fa-solid fa-trash" inert></i></a>
              </td>
            </tr>
          {{/each}}
        {{else}}
          <tr>
            <td colspan="3" class="dense-table-empty-state">{{localize "DOS100.item.conditionals.empty"}}</td>
          </tr>
        {{/if}}
      </tbody>
    </table>
  </div>
</section>
