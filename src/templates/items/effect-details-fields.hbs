<hr />
<div class="dos100-form-group">
  <label for="{{sheetId}}-duration-formula">{{localize "DOS100.effect.duration.label"}}</label>
  <div>
    <input type="text" id="{{sheetId}}-duration-formula" name="system.duration.formula" value="{{item.system.duration.formula}}" />
    <select name="system.duration.unit">
      {{#each durationUnits}}
        <option value="{{@key}}" {{#if (eq @key ../item.system.duration.unit)}}selected{{/if}}>{{localize this}}</option>
      {{/each}}
    </select>
  </div>
</div>
<div class="dos100-form-group">
  <label for="{{sheetId}}-end-timing">{{localize "DOS100.effect.endTiming"}}</label>
  <select id="{{sheetId}}-end-timing" name="system.duration.expiration">
    <option value="" {{#unless item.system.duration.expiration}}selected{{/unless}}>—</option>
    {{#each effectExpirations}}
      <option value="{{@key}}" {{#if (eq @key ../item.system.duration.expiration)}}selected{{/if}}>{{localize this}}</option>
    {{/each}}
  </select>
</div>
<div class="dos100-form-group">
  <label for="{{sheetId}}-stacking-rule">{{localize "DOS100.effect.stackingRule.label"}}</label>
  <select id="{{sheetId}}-stacking-rule" name="system.stackingRule">
    {{#each stackingRules}}
      <option value="{{@key}}" {{#if (eq @key ../item.system.stackingRule)}}selected{{/if}}>{{localize this}}</option>
    {{/each}}
  </select>
</div>
