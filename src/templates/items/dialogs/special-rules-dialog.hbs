<div class="special-rules-dialog">
  <ul>
    {{#each rows}}
      <li data-rule-id-row="{{id}}">
        <select name="mode-{{id}}">
          <option value="inherit" {{#if (eq mode "inherit")}}selected{{/if}}>{{localize "DOS100.item.specialRulesDialog.mode.inherit"}}</option>
          <option value="disabled" {{#if (eq mode "disabled")}}selected{{/if}}>{{localize "DOS100.item.specialRulesDialog.mode.disabled"}}</option>
          <option value="override" {{#if (eq mode "override")}}selected{{/if}}>{{localize "DOS100.item.specialRulesDialog.mode.override"}}</option>
        </select>
        <span>{{localize name}}</span>
        {{#if hasValue}}
          <input
            type="text"
            value="{{formula}}"
            placeholder="{{placeholder}}"
            {{#if formulaDisabled}}disabled{{else}}required{{/if}}
          />
        {{else}}
          <span></span>
        {{/if}}
      </li>
    {{/each}}
  </ul>
  <footer>
    <button type="button" data-action="saveAndClose">{{localize "DOS100.item.specialRulesDialog.save"}}</button>
  </footer>
</div>
