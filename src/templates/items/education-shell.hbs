<div class="dos100-item-sheet dos100-education-sheet">
  {{> "systems/100dos/templates/items/item-header.hbs" img=item.img name=item.name}}

  <div class="dos100-item-content">
    <nav
      class="tabs dos100-item-tabs"
      data-group="primary"
      role="tablist"
      aria-label="{{localize 'TYPES.Item.education'}}"
    >
      {{#each tabs.primary}}
        <button
          type="button"
          class="dos100-item-tab-control {{cssClass}}"
          data-action="tab"
          data-group="primary"
          data-tab="{{id}}"
          role="tab"
          id="{{../sheetId}}-primary-tab-{{id}}"
          aria-selected="{{active}}"
          aria-controls="{{../sheetId}}-primary-panel-{{id}}"
          tabindex="{{#if active}}0{{else}}-1{{/if}}"
        >{{localize label}}</button>
      {{/each}}
    </nav>

    <div class="dos100-item-tab-panels">
      <section
        class="tab{{#if tabs.primary.description.active}} active{{/if}}"
        data-group="primary"
        data-tab="description"
        role="tabpanel"
        id="{{sheetId}}-primary-panel-description"
        aria-labelledby="{{sheetId}}-primary-tab-description"
      >
        <prose-mirror name="system.description" value="{{system.description}}"></prose-mirror>
      </section>

      <section
        class="tab{{#if tabs.primary.details.active}} active{{/if}}"
        data-group="primary"
        data-tab="details"
        role="tabpanel"
        id="{{sheetId}}-primary-panel-details"
        aria-labelledby="{{sheetId}}-primary-tab-details"
      >
        <div class="dos100-form-group">
          <label for="{{sheetId}}-difficulty">{{localize "DOS100.item.skill.difficulty"}}</label>
          <select id="{{sheetId}}-difficulty" name="system.difficulty">
            {{#each difficulties}}
              <option value="{{value}}"{{#if selected}} selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
        </div>

        <div class="dos100-form-group">
          <label for="{{sheetId}}-cost-plus5">{{localize "DOS100.item.education.cost.plus5"}}</label>
          <input type="number" id="{{sheetId}}-cost-plus5" name="system.cost.plus5" value="{{system.cost.plus5}}" step="1" min="0" />
        </div>
        <div class="dos100-form-group">
          <label for="{{sheetId}}-cost-plus10">{{localize "DOS100.item.education.cost.plus10"}}</label>
          <input type="number" id="{{sheetId}}-cost-plus10" name="system.cost.plus10" value="{{system.cost.plus10}}" step="1" min="0" />
        </div>

        <hr />

        <p class="eyebrow-label">{{localize "DOS100.item.education.characteristics"}}</p>
        <div class="dos100-skill-char-checkboxes">
          {{#each characteristics}}
            <label>
              <input type="checkbox" name="system.characteristics" value="{{value}}"{{#if checked}} checked{{/if}} />
              {{label}}
            </label>
          {{/each}}
        </div>

        <p class="eyebrow-label">{{localize "DOS100.item.education.skills"}}</p>
        {{#if system.skills.length}}
          <ul class="dos100-education-skills">
            {{#each system.skills}}
              <li>
                <span>{{this.name}}</span>
                <button
                  type="button"
                  class="icon-button"
                  data-action="deleteEducationSkill"
                  data-index="{{@index}}"
                  aria-label="{{localize "DOS100.item.education.deleteSkill" name=this.name}}"
                ><i class="fa-solid fa-trash" inert></i></button>
              </li>
            {{/each}}
          </ul>
        {{else}}
          <p class="dos100-education-skills-empty">{{localize "DOS100.item.education.skillsEmpty"}}</p>
        {{/if}}

        <hr />

        <div class="dos100-form-group">
          <label for="{{sheetId}}-identifier">{{localize "DOS100.item.identifier"}}</label>
          <input type="text" id="{{sheetId}}-identifier" name="system.identifier" value="{{system.identifier}}" />
        </div>
      </section>
    </div>
  </div>
</div>
