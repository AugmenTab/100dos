<div class="dos100-item-sheet">
<div class="dos100-item-header">
  <img
    class="dos100-item-portrait"
    src="{{item.img}}"
    alt="{{localize "DOS100.item.name"}}"
    data-edit="img"
    data-action="editImage"
  />
  <h1 class="dos100-item-name">
    <input
      name="name"
      type="text"
      value="{{item.name}}"
      placeholder="{{localize 'DOS100.item.name'}}"
      class="{{#if (eq item.system.active false)}}depleted{{/if}}"
    />
  </h1>
</div>

<div class="dos100-item-shell">
  <aside class="dos100-item-sidebar">
    <h3 class="pc-section-heading" aria-hidden="true">{{itemTypeLabel}}</h3>

    <div class="dos100-item-checkboxes">
      <label class="dos100-item-checkbox">
        <input type="checkbox" name="system.active" {{#if item.system.active}}checked{{/if}} />
        {{localize "DOS100.item.active"}}
      </label>
      <label class="dos100-item-checkbox">
        <input type="checkbox" name="system.actions.pinned" {{#if item.system.actions.pinned}}checked{{/if}} />
        {{localize "DOS100.ability.pinned"}}
      </label>
      <label class="dos100-item-checkbox">
        <input type="checkbox" name="system.showInCombatTab" {{#if item.system.showInCombatTab}}checked{{/if}} />
        {{localize "DOS100.ability.combatTab"}}
      </label>
    </div>

    <div class="dos100-item-sidebar-tags">
      <span class="eyebrow-label">{{localize "DOS100.ability.tags"}}</span>
      <div class="dos100-item-tags">
        {{#each item.system.tags}}
          <span class="dos100-item-tag">{{this}}</span>
        {{/each}}
      </div>
    </div>
  </aside>

  <div class="dos100-item-content">
    <nav
      class="tabs dos100-item-tabs"
      data-group="primary"
      role="tablist"
      aria-label="{{itemTypeLabel}}"
    >
      {{#each tabs.primary}}
        <button
          type="button"
          class="dos100-item-tab-control {{cssClass}}"
          data-action="tab"
          data-group="primary"
          data-tab="{{id}}"
          role="tab"
          id="{{../sheetId}}-primary-tab-{{id}}"
          aria-selected="{{active}}"
          aria-controls="{{../sheetId}}-primary-panel-{{id}}"
          tabindex="{{#if active}}0{{else}}-1{{/if}}"
        >{{localize label}}</button>
      {{/each}}
    </nav>

    {{> "systems/100dos/templates/items/shell/description-tab.hbs"}}

    <section
      class="tab{{#if tabs.primary.details.active}} active{{/if}}"
      data-group="primary"
      data-tab="details"
      role="tabpanel"
      id="{{sheetId}}-primary-panel-details"
      aria-labelledby="{{sheetId}}-primary-tab-details"
    >
      <h2>{{localize "DOS100.item.tabs.details"}}</h2>
      {{!-- TODO: Replace with real Details content. --}}
      <p>This page doesn't have any content yet.</p>
    </section>

    {{> "systems/100dos/templates/items/shell/changes-tab.hbs"}}
  </div>
</div>
</div>
