<div class="dos100-item-header">
  <img
    class="dos100-item-portrait"
    src="{{item.img}}"
    alt="{{localize "DOS100.item.name"}}"
    data-edit="img"
    data-action="editImage"
  />
  <input name="name" type="text" value="{{item.name}}" placeholder="{{localize 'DOS100.item.name'}}" />
</div>
