<form class="dos100-action-sheet" autocomplete="off">
  {{> "systems/100dos/templates/items/item-header.hbs" img=action.img name=action.name}}

  <nav
    class="tabs dos100-item-tabs"
    data-group="primary"
    role="tablist"
    aria-label="{{localize 'DOS100.item.actionSheet.title'}}"
  >
    {{#each tabs.primary}}
      <button
        type="button"
        class="dos100-item-tab-control {{cssClass}}"
        data-action="tab"
        data-group="primary"
        data-tab="{{id}}"
        role="tab"
        id="{{../sheetId}}-primary-tab-{{id}}"
        aria-selected="{{active}}"
        aria-controls="{{../sheetId}}-primary-panel-{{id}}"
        tabindex="{{#if active}}0{{else}}-1{{/if}}"
      >{{localize label}}</button>
    {{/each}}
  </nav>

  <div class="dos100-action-tab-panels">
    <section
      class="tab{{#if tabs.primary.description.active}} active{{/if}}"
      data-group="primary"
      data-tab="description"
      role="tabpanel"
      id="{{sheetId}}-primary-panel-description"
      aria-labelledby="{{sheetId}}-primary-tab-description"
    >
      <div class="dos100-form-group">
        <label for="{{sheetId}}-identifier">{{localize "DOS100.item.identifier"}}</label>
        <input type="text" id="{{sheetId}}-identifier" name="identifier" value="{{action.identifier}}" />
      </div>
      <prose-mirror name="description" value="{{action.description}}"></prose-mirror>
    </section>

    <section
      class="tab{{#if tabs.primary.usage.active}} active{{/if}}"
      data-group="primary"
      data-tab="usage"
      role="tabpanel"
      id="{{sheetId}}-primary-panel-usage"
      aria-labelledby="{{sheetId}}-primary-tab-usage"
    >
      <div class="dos100-form-group">
        <label for="{{sheetId}}-activation-type">{{localize "DOS100.action.activation.cost"}}</label>
        <div>
          <input type="number" id="{{sheetId}}-activation-cost" name="activation.cost" value="{{action.activation.cost}}" min="1" step="1" />
          <select id="{{sheetId}}-activation-type" name="activation.type">
            {{#each activationTypes}}
              <option value="{{value}}" {{#if selected}}selected{{/if}}>{{localize label}}</option>
            {{/each}}
          </select>
        </div>
      </div>

      <hr />

      <div class="dos100-form-group">
        <label for="{{sheetId}}-target">{{localize "DOS100.action.target"}}</label>
        <input type="text" id="{{sheetId}}-target" name="target" value="{{action.target}}" />
      </div>

      <div class="dos100-form-group">
        <label for="{{sheetId}}-range-type">{{localize "DOS100.action.range.label"}}</label>
        <div>
          <input type="text" id="{{sheetId}}-range-value" name="range.value" value="{{action.range.value}}" />
          <select id="{{sheetId}}-range-type" name="range.type">
            {{#each rangeTypes}}
              <option value="{{value}}" {{#if selected}}selected{{/if}}>{{localize label}}</option>
            {{/each}}
          </select>
        </div>
      </div>

      <div class="dos100-form-group">
        <label for="{{sheetId}}-area">{{localize "DOS100.action.area"}}</label>
        <input type="text" id="{{sheetId}}-area" name="area" value="{{action.area}}" />
      </div>

      <div class="dos100-form-group">
        <label for="{{sheetId}}-duration-type">{{localize "DOS100.action.duration.label"}}</label>
        <div>
          <input type="text" id="{{sheetId}}-duration-value" name="duration.value" value="{{action.duration.value}}" />
          <select id="{{sheetId}}-duration-type" name="duration.type">
            {{#each durationTypes}}
              <option value="{{value}}" {{#if selected}}selected{{/if}}>{{localize label}}</option>
            {{/each}}
          </select>
        </div>
      </div>

      <div class="dos100-form-group">
        <label></label>
        <div>
          <label>
            <input type="checkbox" name="concentration" {{#if action.concentration}}checked{{/if}} />
            {{localize "DOS100.action.concentration"}}
          </label>
          <label>
            <input type="checkbox" name="dismissible" {{#if action.dismissible}}checked{{/if}} />
            {{localize "DOS100.action.dismissible"}}
          </label>
        </div>
      </div>
    </section>

    <section
      class="tab{{#if tabs.primary.action.active}} active{{/if}}"
      data-group="primary"
      data-tab="action"
      role="tabpanel"
      id="{{sheetId}}-primary-panel-action"
      aria-labelledby="{{sheetId}}-primary-tab-action"
    >
      <h1>{{localize "DOS100.item.actionSheet.tabs.action"}}</h1>
      <p>{{localize "DOS100.item.actionSheet.placeholder"}}</p>
    </section>

    <section
      class="tab{{#if tabs.primary.miscellaneous.active}} active{{/if}}"
      data-group="primary"
      data-tab="miscellaneous"
      role="tabpanel"
      id="{{sheetId}}-primary-panel-miscellaneous"
      aria-labelledby="{{sheetId}}-primary-tab-miscellaneous"
    >
      <h1>{{localize "DOS100.item.actionSheet.tabs.miscellaneous"}}</h1>
      <p>{{localize "DOS100.item.actionSheet.placeholder"}}</p>
    </section>
  </div>
</form>
