<form class="dos100-action-sheet" autocomplete="off">
  {{> "systems/100dos/templates/items/item-header.hbs" img=action.img name=action.name}}

  <nav
    class="tabs dos100-item-tabs"
    data-group="primary"
    role="tablist"
    aria-label="{{localize 'DOS100.item.actionSheet.title'}}"
  >
    {{#each tabs.primary}}
      <button
        type="button"
        class="dos100-item-tab-control {{cssClass}}"
        data-action="tab"
        data-group="primary"
        data-tab="{{id}}"
        role="tab"
        id="{{../sheetId}}-primary-tab-{{id}}"
        aria-selected="{{active}}"
        aria-controls="{{../sheetId}}-primary-panel-{{id}}"
        tabindex="{{#if active}}0{{else}}-1{{/if}}"
      >{{localize label}}</button>
    {{/each}}
  </nav>

  <div class="dos100-action-tab-panels">
    <section
      class="tab{{#if tabs.primary.description.active}} active{{/if}}"
      data-group="primary"
      data-tab="description"
      role="tabpanel"
      id="{{sheetId}}-primary-panel-description"
      aria-labelledby="{{sheetId}}-primary-tab-description"
    >
      <div class="dos100-form-group">
        <label for="{{sheetId}}-identifier">{{localize "DOS100.item.identifier"}}</label>
        <input type="text" id="{{sheetId}}-identifier" name="identifier" value="{{action.identifier}}" />
      </div>
      <prose-mirror name="description" value="{{action.description}}"></prose-mirror>
    </section>

    <section
      class="tab{{#if tabs.primary.usage.active}} active{{/if}}"
      data-group="primary"
      data-tab="usage"
      role="tabpanel"
      id="{{sheetId}}-primary-panel-usage"
      aria-labelledby="{{sheetId}}-primary-tab-usage"
    >
      <div class="dos100-form-group">
        <label for="{{sheetId}}-activation-type">{{localize "DOS100.action.activation.cost"}}</label>
        <div>
          <input type="number" id="{{sheetId}}-activation-cost" name="activation.cost" value="{{action.activation.cost}}" min="1" step="1" />
          <select id="{{sheetId}}-activation-type" name="activation.type">
            {{#each activationTypes}}
              <option value="{{value}}" {{#if selected}}selected{{/if}}>{{localize label}}</option>
            {{/each}}
          </select>
        </div>
      </div>

      <hr />

      <div class="dos100-form-group">
        <label for="{{sheetId}}-target">{{localize "DOS100.action.target"}}</label>
        <input type="text" id="{{sheetId}}-target" name="target" value="{{action.target}}" />
      </div>

      <div class="dos100-form-group">
        <label for="{{sheetId}}-range-type">{{localize "DOS100.action.range.label"}}</label>
        <div>
          <input type="text" id="{{sheetId}}-range-value" name="range.value" value="{{action.range.value}}" />
          <select id="{{sheetId}}-range-type" name="range.type">
            {{#each rangeTypes}}
              <option value="{{value}}" {{#if selected}}selected{{/if}}>{{localize label}}</option>
            {{/each}}
          </select>
        </div>
      </div>

      <div class="dos100-form-group">
        <label for="{{sheetId}}-area">{{localize "DOS100.action.area"}}</label>
        <input type="text" id="{{sheetId}}-area" name="area" value="{{action.area}}" />
      </div>

      <div class="dos100-form-group">
        <label for="{{sheetId}}-duration-type">{{localize "DOS100.action.duration.label"}}</label>
        <div>
          <input type="text" id="{{sheetId}}-duration-value" name="duration.value" value="{{action.duration.value}}" />
          <select id="{{sheetId}}-duration-type" name="duration.type">
            {{#each durationTypes}}
              <option value="{{value}}" {{#if selected}}selected{{/if}}>{{localize label}}</option>
            {{/each}}
          </select>
        </div>
      </div>

      <div class="dos100-form-group">
        <label></label>
        <div>
          <label>
            <input type="checkbox" name="concentration" {{#if action.concentration}}checked{{/if}} />
            {{localize "DOS100.action.concentration"}}
          </label>
          <label>
            <input type="checkbox" name="dismissible" {{#if action.dismissible}}checked{{/if}} />
            {{localize "DOS100.action.dismissible"}}
          </label>
        </div>
      </div>

      <hr />

      <div class="dos100-item-notes">
        <div class="dense-table-wrap">
          <table class="dense-table">
            <thead>
              <tr>
                <th scope="col" class="dense-table-flexible">{{localize "DOS100.item.effectNotes.label"}}</th>
                <th scope="col">
                  <a role="button" tabindex="0" class="icon-button" data-action="addActionEffectNote" aria-label="{{localize 'DOS100.item.effectNotes.add'}}">
                    <i class="fa-solid fa-plus" inert></i>
                  </a>
                </th>
              </tr>
            </thead>
            <tbody>
              {{#each action.notes.effectNotes}}
                <tr>
                  <td class="dense-table-flexible">
                    <input type="text" name="notes.effectNotes.{{@index}}" value="{{this}}" />
                  </td>
                  <td>
                    <a role="button" tabindex="0" class="icon-button" data-action="deleteActionEffectNote" data-identifier="{{@index}}" aria-label="{{localize 'DOS100.item.effectNotes.delete'}}"><i class="fa-solid fa-trash" inert></i></a>
                  </td>
                </tr>
              {{else}}
                <tr>
                  <td colspan="2" class="dense-table-empty-state">{{localize "DOS100.item.effectNotes.empty"}}</td>
                </tr>
              {{/each}}
            </tbody>
          </table>
        </div>

        <div class="dense-table-wrap">
          <table class="dense-table">
            <thead>
              <tr>
                <th scope="col" class="dense-table-flexible">{{localize "DOS100.item.footnotes.label"}}</th>
                <th scope="col">
                  <a role="button" tabindex="0" class="icon-button" data-action="addActionFootnote" aria-label="{{localize 'DOS100.item.footnotes.add'}}">
                    <i class="fa-solid fa-plus" inert></i>
                  </a>
                </th>
              </tr>
            </thead>
            <tbody>
              {{#each action.notes.footnotes}}
                <tr>
                  <td class="dense-table-flexible">
                    <input type="text" name="notes.footnotes.{{@index}}" value="{{this}}" />
                  </td>
                  <td>
                    <a role="button" tabindex="0" class="icon-button" data-action="deleteActionFootnote" data-identifier="{{@index}}" aria-label="{{localize 'DOS100.item.footnotes.delete'}}"><i class="fa-solid fa-trash" inert></i></a>
                  </td>
                </tr>
              {{else}}
                <tr>
                  <td colspan="2" class="dense-table-empty-state">{{localize "DOS100.item.footnotes.empty"}}</td>
                </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
      </div>

      <hr />

      <h4 class="pc-section-heading">{{localize "DOS100.action.uses.item"}}</h4>
      <div class="dos100-form-group">
        <label for="{{sheetId}}-item-cost-formula">{{localize "DOS100.action.uses.chargeCost"}}</label>
        <div>
          <input type="text" id="{{sheetId}}-item-cost-formula" name="uses.itemCost.formula" value="{{action.uses.itemCost.formula}}" />
          <label>
            <input type="checkbox" name="uses.itemCost.perAttack" {{#if action.uses.itemCost.perAttack}}checked{{/if}} />
            {{localize "DOS100.action.uses.perAttack"}}
          </label>
        </div>
      </div>

      <h4 class="pc-section-heading">{{localize "DOS100.action.uses.action"}}</h4>
      <div class="dos100-form-group">
        <label for="{{sheetId}}-action-cost-formula">{{localize "DOS100.action.uses.chargeCost"}}</label>
        <div>
          <input type="text" id="{{sheetId}}-action-cost-formula" name="uses.actionCost.formula" value="{{action.uses.actionCost.formula}}" />
          <label>
            <input type="checkbox" name="uses.actionCost.perAttack" {{#if action.uses.actionCost.perAttack}}checked{{/if}} />
            {{localize "DOS100.action.uses.perAttack"}}
          </label>
        </div>
      </div>
      <div class="dos100-form-group">
        <label for="{{sheetId}}-uses-per">{{localize "DOS100.action.uses.limitedUses"}}</label>
        <div>
          <input type="number" name="uses.value" value="{{action.uses.value}}" min="0" step="1" class="dos100-uses-value" />
          <span class="dos100-uses-max" aria-hidden="true">/ {{action.uses.max}}</span>
          <select id="{{sheetId}}-uses-per" name="uses.per">
            {{#each usagePeriods}}
              <option value="{{value}}" {{#if selected}}selected{{/if}}>{{localize label}}</option>
            {{/each}}
          </select>
        </div>
      </div>
      <div class="dos100-form-group">
        <label for="{{sheetId}}-max-uses-formula">{{localize "DOS100.action.uses.maximumUses"}}</label>
        <input type="text" id="{{sheetId}}-max-uses-formula" name="uses.formula" value="{{action.uses.formula}}" />
      </div>
    </section>

    <section
      class="tab{{#if tabs.primary.action.active}} active{{/if}}"
      data-group="primary"
      data-tab="action"
      role="tabpanel"
      id="{{sheetId}}-primary-panel-action"
      aria-labelledby="{{sheetId}}-primary-tab-action"
    >
      <div class="dos100-form-group">
        <label for="{{sheetId}}-action-type">{{localize "DOS100.action.type.label"}}</label>
        <select id="{{sheetId}}-action-type" name="type">
          {{#each actionTypes}}
            <option value="{{value}}" {{#if selected}}selected{{/if}}>{{localize label}}</option>
          {{/each}}
        </select>
      </div>
    </section>

    <section
      class="tab{{#if tabs.primary.miscellaneous.active}} active{{/if}}"
      data-group="primary"
      data-tab="miscellaneous"
      role="tabpanel"
      id="{{sheetId}}-primary-panel-miscellaneous"
      aria-labelledby="{{sheetId}}-primary-tab-miscellaneous"
    >
      <h1>{{localize "DOS100.item.actionSheet.tabs.miscellaneous"}}</h1>
      <p>{{localize "DOS100.item.actionSheet.placeholder"}}</p>
    </section>
  </div>
</form>
