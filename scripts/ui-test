#!/usr/bin/env sh
set -eu

if [ ! -f .env ]; then
  echo "Missing .env — copy .env.example to .env and fill in Foundry credentials." >&2
  exit 1
fi

BASE_URL="http://foundry-test:30000"
# Deliberately outside test-results/ and test-results-browser/ — both are
# Playwright outputDirs that get cleared at the start of a run, and this
# script runs both configs concurrently.
BROWSER_LOG=".browser-tier-run.log"
FOUNDRY_EXIT=0
BROWSER_EXIT=0

cleanup() {
  docker compose --profile test stop foundry-test >/dev/null 2>&1 || true
}
trap cleanup EXIT INT TERM

echo "==> Building the 100dos system"
docker compose run --rm dev sh -c "npm install && npm run build"

echo "==> Installing e2e/browser-tier dependencies"
docker compose run --rm e2e npm install

echo "==> Clearing any stale Foundry lock left by an unclean previous shutdown"
rm -rf foundrytestdata/Config/options.json.lock

echo "==> Starting dedicated test Foundry instance"
docker compose --profile test up -d foundry-test

# The lightweight browser tier (test/browser/) needs no Foundry world or
# session at all — it renders production templates/CSS directly against a
# bare Chromium page. Running it while the Foundry instance boots, instead
# of stacking its cost on top afterward, is real concurrency: the two
# suites use separate containers and don't compete for the same resources
# (one lightweight Chromium page vs. a live Foundry world). The npm
# install above already happened once, sequentially, before either
# container starts — concurrent `npm install`s against the same shared
# volume would race.
echo "==> Running lightweight browser tier (concurrently with Foundry startup)"
docker compose run --rm e2e npx playwright test --config=playwright.browser.config.ts >"$BROWSER_LOG" 2>&1 &
BROWSER_PID=$!

echo "==> Waiting for foundry-test to become responsive"
docker compose run --rm e2e node test/e2e/support/wait-for-ready.ts "$BASE_URL"

echo "==> Running real-Foundry Playwright suite"
docker compose run --rm e2e npx playwright test || FOUNDRY_EXIT=$?

echo "==> Waiting for lightweight browser tier to finish"
wait "$BROWSER_PID" || BROWSER_EXIT=$?
cat "$BROWSER_LOG"
rm -f "$BROWSER_LOG"

if [ "$FOUNDRY_EXIT" -ne 0 ] || [ "$BROWSER_EXIT" -ne 0 ]; then
  exit 1
fi
exit 0
