{
  "name": "100dos",
  "version": "0.0.1",
  "description": "A Foundry VTT implementation for the 100DOS TTRPG system.",
  "scripts": {
    "build": "vite build",
    "watch": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "test": "vitest run",
    "test:ui": "playwright test",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@types/node": "^25.9.1",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "handlebars": "4.7.9",
    "less": "^4.9.0",
    "prettier": "^3.8.3",
    "typescript": "^5",
    "typescript-eslint": "^8.60.0",
    "vite": "^6",
    "vite-plugin-static-copy": "^2",
    "vitest": "^3.2.6"
  }
}
